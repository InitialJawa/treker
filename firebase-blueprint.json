{
  "collections": [
    {
      "name": "users",
      "description": "User profiles and SaaS metadata",
      "fields": [
        { "name": "email", "type": "string" },
        { "name": "displayName", "type": "string" },
        { "name": "photoUrl", "type": "string" },
        { "name": "subscriptionPlan", "type": "string" },
        { "name": "subscriptionStatus", "type": "string" },
        { "name": "tripsCreatedThisMonth", "type": "number" },
        { "name": "createdAt", "type": "timestamp" }
      ]
    },
    {
      "name": "trips",
      "description": "Trip Workspaces",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "tenantId", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "allowPublicView", "type": "boolean" },
        { "name": "coverImage", "type": "string" },
        { "name": "createdAt", "type": "timestamp" }
      ],
      "subcollections": [
        {
          "name": "roles",
          "description": "Collaborator roles (uid as document ID)",
          "fields": [
            { "name": "role", "type": "string" }
          ]
        },
        {
          "name": "itineraries",
          "description": "Itinerary details for the trip",
          "fields": [
            { "name": "title", "type": "string" },
            { "name": "category", "type": "string" },
            { "name": "estimatedCost", "type": "number" }
          ]
        },
        {
          "name": "expenses",
          "description": "Trip expenses",
          "fields": [
            { "name": "title", "type": "string" },
            { "name": "actualAmount", "type": "number" }
          ]
        }
      ]
    }
  ]
}